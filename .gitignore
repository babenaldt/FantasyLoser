# Virtual environment
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Generated data (intermediate output)
output/league_data/
output/*.json

# Accidental output from running generators in the wrong directory
scripts/output/
scripts/website/
website/output/
website/website/

# One-off scratch from draft night and ad-hoc scripts
temp_*

# Generated website data (dynamically created, not committed)
website/public/data/*.json

# Keep archived season data
!website/public/data/archive/

# Website build output
website/dist/
website/.astro/
website/node_modules/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
