---
interface Item {
  label: string;
  value: string | number;
  detail?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="score-strip" aria-label="Key league figures">
  {items.map((item) => (
    <div class="score-strip__item">
      <div class="score-strip__label">{item.label}</div>
      <div class="score-strip__value">{item.value}</div>
      {item.detail && <div class="score-strip__detail">{item.detail}</div>}
    </div>
  ))}
</div>
