---
import survivalDataRaw from '../../../public/data/chopped_survival_odds.json';
import timeseriesRaw from '../../../public/data/chopped_survival_timeseries.json';

interface Props {
  weekNum: number;
  data: any;
  basePath?: string;
}

const { weekNum, data, basePath = '/weekly-review-chopped' } = Astro.props;
const totalWeeks = data.total_weeks || 0;
const weekData = (data.weeks || []).find((week: any) => week.week === weekNum);
const isEmpty = !weekData;
const previous = weekNum > 1 ? weekNum - 1 : null;
const next = weekNum < totalWeeks ? weekNum + 1 : null;
const awards = weekData?.awards || {};
const allPlay = weekData?.all_play || [];
const faabActivity = weekData?.faab_activity || [];
const teamScores = weekData?.team_scores || [];
const elimination = weekData?.elimination;
const faabWeekTotal = weekData?.faab_week_total || 0;
const cumulativeFaab = (data.faab_summary?.cumulative_by_week || []).find(
  (item: any) => item.week === weekNum
);

const numEliminated = elimination?.num_eliminated || 0;
const eliminatedNames = new Set((elimination?.eliminated_teams || []).map((e: any) => e.owner_name));

// Chopped-specific award config (lucky_escape instead of close_call/blowout)
const awardConfig = [
  { key: 'top_scorer', title: 'Top Scorer', stat: (a: any) => `${a.points} pts` },
  { key: 'bust', title: 'Bust of the Week', stat: (a: any) => `${a.points} pts` },
  { key: 'efficiency_king', title: 'Efficiency King', stat: (a: any) => `${a.efficiency}%` },
  { key: 'overachiever', title: 'Overachiever', stat: (a: any) => `Only ${a.missed} pts missed` },
  { key: 'underachiever', title: 'Underachiever', stat: (a: any) => `${a.missed} pts left on table` },
  { key: 'bench_boss', title: 'Bench Boss', stat: (a: any) => `${a.bench_points} bench pts` },
  { key: 'lucky_escape', title: 'Lucky Escape', stat: (a: any) => `Survived by ${a.margin} pts` },
  { key: 'player_of_week', title: 'Player of the Week', stat: (a: any) => `${a.points} pts (${a.position})`, name: (a: any) => a.player_name, sub: (a: any) => `Rostered by ${a.owner}` },
  { key: 'faab_spender', title: 'FAAB Big Spender', stat: (a: any) => `$${a.total_spent} spent` },
];

// Monte Carlo survival odds for the current week (written by scripts/chopped_week.py).
const survivalData = survivalDataRaw as any;
const showSurvival =
  survivalData &&
  survivalData.week === weekNum &&
  Array.isArray(survivalData.teams) &&
  survivalData.teams.length > 0;

// Survival-odds time series: one tick per brief run during the week.
// The x-axis is event ticks (not wall-clock time) so the TNF-to-Sunday
// dead air costs nothing — same spirit as a win-probability chart.
const tsRaw = timeseriesRaw as any;
const tsSeries = (tsRaw?.[String(weekNum)] || []) as any[];
const showTsChart = showSurvival && tsSeries.length >= 2;
const tsOwners = [...new Set(tsSeries.flatMap((s: any) => Object.keys(s.odds || {})))] as string[];
const TS_W = 720, TS_H = 340, TS_PL = 46, TS_PR = 14, TS_PT = 16, TS_PB = 36;
const tsX = (i: number) =>
  TS_PL + (tsSeries.length <= 1 ? 0 : (i * (TS_W - TS_PL - TS_PR)) / (tsSeries.length - 1));
const tsY = (p: number) => {
  const c = Math.min(1, Math.max(0, p || 0));
  return TS_PT + (1 - c) * (TS_H - TS_PT - TS_PB);
};
const tsVals = tsOwners.map((owner) => {
  const raw = tsSeries.map((s: any) => (s.odds || {})[owner]);
  const firstKnown = raw.find((v: any) => v != null);
  let last: number | null = null;
  const vals = raw.map((v: any) => {
    if (v != null) last = v;
    else if (last == null) last = firstKnown;
    return last ?? 0;
  });
  const path = vals
    .map((v: number, i: number) => `${i === 0 ? "M" : "L"}${tsX(i).toFixed(1)},${tsY(v).toFixed(1)}`)
    .join(" ");
  return { owner, vals, path };
});
const tsSean = tsVals.find((t) => t.owner === "SeanRabenaldt");
const tsOthers = tsVals.filter((t) => t.owner !== "SeanRabenaldt");
---

<div class="edition-bar">
  <span>Week {weekNum} Review</span>
  <span>Chopped League — {data.season || '2026'}</span>
</div>

<div class="almanac-week-nav">
  {previous
    ? <a href={`${basePath}/${previous}`}>← Week {previous}</a>
    : <span class="disabled">← Prev</span>}
  <div>
    <h1>Week {weekNum} Review</h1>
    <p>Chopped League — {data.season || '2026'}</p>
    {totalWeeks > 1 && (
      <label>
        <span class="sr-only">Jump to week</span>
        <select id="almanacWeekJump">
          {Array.from({ length: totalWeeks }, (_, index) => index + 1).map((week) => (
            <option value={week} selected={week === weekNum}>Week {week}</option>
          ))}
        </select>
      </label>
    )}
  </div>
  {next
    ? <a href={`${basePath}/${next}`}>Week {next} →</a>
    : <span class="disabled">Next →</span>}
</div>

{showSurvival && (
  <section>
    <div class="section-heading"><h2>Survival Odds</h2><span>{(survivalData.n_sims || 0).toLocaleString()} sims · {survivalData.chops} chop{survivalData.chops !== 1 ? 's' : ''}</span></div>
    <p class="section-copy">
      Monte Carlo probability of surviving the Week {weekNum} chop · cut line {survivalData.cut_mean} ± {survivalData.cut_sd} · {survivalData.need_95} pts for 95% safety
    </p>
    <div class="odds-grid">
      {survivalData.teams.map((team: any) => {
        const probability = (team.p_survive || 0) * 100;
        return (
          <div class="odds-row">
            <span>{team.owner}</span><i><b style={`width:${probability}%`}></b></i><strong>{probability.toFixed(1)}%</strong>
          </div>
        );
      })}
    </div>
    {showTsChart && (
      <div class="ts-wrap">
        <h3>Survival odds as the week unfolded</h3>
        <svg viewBox={`0 0 ${TS_W} ${TS_H}`} role="img" aria-label="Survival odds over the course of the week">
          {[0, 25, 50, 75, 100].map((g) => (
            <g>
              <line x1={TS_PL} x2={TS_W - TS_PR} y1={tsY(g / 100)} y2={tsY(g / 100)} class="ts-grid" />
              <text x={TS_PL - 8} y={tsY(g / 100) + 4} text-anchor="end" class="ts-axis">{g}%</text>
            </g>
          ))}
          {tsSeries.map((s: any, i: number) => (
            <text x={tsX(i)} y={TS_H - 12} text-anchor="middle" class="ts-axis">{s.label}</text>
          ))}
          {tsOthers.map((t) => (
            <path d={t.path} class="ts-line" fill="none"><title>{t.owner}</title></path>
          ))}
          {tsSean && (
            <g>
              <path d={tsSean.path} class="ts-line ts-sean" fill="none" />
              {tsSean.vals.map((v: number, i: number) => (
                <circle cx={tsX(i)} cy={tsY(v)} r="3.5" class="ts-dot"><title>{`Sean: ${(v * 100).toFixed(1)}%`}</title></circle>
              ))}
            </g>
          )}
        </svg>
        <p class="section-copy">Each tick is one report run — Sean in <span class="ts-key">rust</span>, hover any line for the team. The week resolves on the final tick.</p>
      </div>
    )}
  </section>
)}

{isEmpty ? (
  <section class="empty-state">
    <h2>No Data for Week {weekNum}</h2>
    <p>This week hasn't been completed yet. Check back after games finish.</p>
  </section>
) : (
  <>
    {elimination && (
      <section>
        <div class="section-heading"><h2>Chopped This Week</h2><span>{numEliminated} eliminated</span></div>
        <div class="score-strip">
          {(elimination.eliminated_teams || []).map((e: any) => (
            <div class="score-strip__item">
              <div class="score-strip__label">{e.owner_name}</div>
              <div class="score-strip__value">{e.points?.toFixed(1)}</div>
            </div>
          ))}
        </div>
        <p class="section-copy">
          Survival threshold: <strong>{elimination.survival_threshold?.toFixed(1)} pts</strong>
          {' '}— {teamScores.length - numEliminated} teams remain
        </p>
      </section>
    )}

    {(() => {
      const bw = weekData?.bye_warnings;
      if (!bw || !Array.isArray(bw.rows) || !bw.rows.length) return null;
      const atRisk = bw.rows.filter((r: any) => (r.crunch || 0) > 0.5);
      return (
        <section>
          <div class="section-heading"><h2>Bye Week Warnings</h2><span>Week {bw.week} byes: {(bw.byes || []).join(', ') || 'none'}</span></div>
          <p class="section-copy">
            Projected points each surviving team loses to byes next week if nobody makes a move —
            waiver adds will soften the blow. {atRisk.length} of {bw.rows.length} teams take a hit.
          </p>
          <div class="retro-table-wrap">
            <table class="retro-table">
              <thead>
                <tr><th>Team</th><th>Full Lineup</th><th>Depleted</th><th>Lost</th><th>Key Losses</th></tr>
              </thead>
              <tbody>
                {bw.rows.map((r: any) => (
                  <tr>
                    <td class="team-cell">{r.owner}</td>
                    <td>{r.full?.toFixed(1)}</td>
                    <td>{r.depleted?.toFixed(1)}</td>
                    <td data-value={r.crunch || 0}>-{(r.crunch || 0).toFixed(1)}</td>
                    <td>{(r.lost || []).map((p: any) => `${p.name} (${p.pos}, ${p.proj})`).join(', ') || '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      );
    })()}

    <section>
      <div class="section-heading"><h2>Weekly Awards</h2></div>
      <div class="award-grid">
        {awardConfig.map((config) => {
          const award = awards[config.key];
          if (!award) return null;
          const displayName = config.name ? config.name(award) : award.owner_name;
          return (
            <article class="award-cell">
              <div class="award-cell__title">{config.title}</div>
              <div class="award-cell__name">{displayName}</div>
              <div class="award-cell__stat">{config.stat(award)}</div>
              {config.sub && <div class="award-cell__sub">{config.sub(award)}</div>}
            </article>
          );
        })}
      </div>
    </section>

    <section>
      <div class="section-heading"><h2>Scoreboard</h2></div>
      <div class="retro-table-wrap">
        <table class="retro-table">
          <thead>
            <tr><th>#</th><th>Team</th><th>Score</th><th>Optimal</th><th>Efficiency</th><th>Status</th></tr>
          </thead>
          <tbody>
            {teamScores.map((team: any, index: number) => {
              const isChopped = eliminatedNames.has(team.owner_name);
              return (
                <tr>
                  <td class="rank">{index + 1}</td>
                  <td class="team-cell">{team.owner_name}</td>
                  <td>{team.points?.toFixed(1)}</td>
                  <td>{team.optimal?.toFixed(1)}</td>
                  <td>{team.efficiency}%</td>
                  <td>{isChopped ? <span class="status-chopped">Chopped</span> : <span class="status-safe">Safe</span>}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <div class="section-heading"><h2>All-Play Rankings</h2></div>
      <p class="section-copy">How each team would have done against every other team this week</p>
      <div class="retro-table-wrap">
        <table class="retro-table">
          <thead>
            <tr><th>Rank</th><th>Team</th><th>Points</th><th>All-Play W</th><th>All-Play L</th><th>All-Play %</th></tr>
          </thead>
          <tbody>
            {allPlay.map((team: any, index: number) => {
              const total = team.all_play_wins + team.all_play_losses + team.all_play_ties;
              const percentage = total > 0 ? ((team.all_play_wins / total) * 100).toFixed(0) : '0';
              return (
                <tr>
                  <td class="rank">{index + 1}</td>
                  <td class="team-cell">{team.owner_name}</td>
                  <td>{team.points?.toFixed(1)}</td>
                  <td>{team.all_play_wins}</td>
                  <td>{team.all_play_losses}</td>
                  <td>{percentage}%</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <div class="section-heading"><h2>FAAB Activity</h2></div>
      <div class="score-strip">
        <div class="score-strip__item"><div class="score-strip__label">Spent This Week</div><div class="score-strip__value">${faabWeekTotal}</div></div>
        <div class="score-strip__item"><div class="score-strip__label">Transactions</div><div class="score-strip__value">{faabActivity.length}</div></div>
        {cumulativeFaab && (
          <div class="score-strip__item"><div class="score-strip__label">League Total (Season)</div><div class="score-strip__value">${cumulativeFaab.cumulative}</div></div>
        )}
      </div>
      {faabActivity.length ? (
        <div class="retro-table-wrap faab-table">
          <table class="retro-table">
            <thead><tr><th>Owner</th><th>Added</th><th>Dropped</th><th>Bid</th></tr></thead>
            <tbody>
              {faabActivity.map((transaction: any) => (
                <tr>
                  <td class="team-cell">{transaction.owner}</td>
                  <td>{(transaction.added || []).map((player: any) => `${player.player_name} (${player.position})`).join(', ') || '—'}</td>
                  <td>{(transaction.dropped || []).map((player: any) => `${player.player_name} (${player.position})`).join(', ') || '—'}</td>
                  <td>${transaction.bid}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : <p class="no-data">No FAAB transactions this week</p>}
    </section>
  </>
)}

<script define:vars={{ basePath }}>
  const dropdown = document.getElementById('almanacWeekJump');
  dropdown?.addEventListener('change', () => {
    window.location.href = `${basePath}/${dropdown.value}`;
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .almanac-week-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    border: 1px solid var(--forest);
    background: rgba(255,255,255,.35);
    padding: 12px;
    text-align: center;
  }

  .almanac-week-nav h1 {
    margin: 0;
    font: 900 28px/1 var(--sans);
    text-transform: uppercase;
  }

  .almanac-week-nav p {
    margin: 5px 0 0;
    color: var(--muted);
    font-size: 12px;
  }

  .almanac-week-nav a,
  .almanac-week-nav .disabled {
    font: 900 11px/1 var(--sans);
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .almanac-week-nav a:last-child,
  .almanac-week-nav .disabled:last-child {
    text-align: right;
  }

  .almanac-week-nav select {
    margin-top: 7px;
    border: 1px solid var(--ink);
    background: var(--white);
    padding: 5px 8px;
  }

  .award-cell__sub,
  .section-copy,
  .no-data {
    color: var(--muted);
    font-size: 12px;
  }

  .award-cell__stat,
  .award-cell__sub {
    overflow-wrap: anywhere;
  }

  .faab-table {
    margin-top: 12px;
  }

  .faab-table td:nth-child(2),
  .faab-table td:nth-child(3) {
    text-align: left;
    font-family: var(--sans);
  }

  .empty-state {
    border: 1px solid var(--forest);
    background: var(--white);
    padding: 32px;
    text-align: center;
  }

  .odds-grid { border: 1px solid var(--rule); background: var(--white); padding: 12px; }
  .odds-row { display: grid; grid-template-columns: 130px 1fr 58px; gap: 10px; align-items: center; padding: 6px 0; font: 800 12px var(--sans); }
  .odds-row i { height: 12px; background: var(--paper-deep); }
  .odds-row i b { display: block; height: 100%; background: var(--rust); }
  .odds-row strong { text-align: right; font-family: var(--mono); }

  .ts-wrap { margin-top: 18px; border: 1px solid var(--rule); background: var(--white); padding: 12px; }
  .ts-wrap h3 { margin: 0 0 8px; font: 900 13px/1.2 var(--sans); text-transform: uppercase; letter-spacing: .06em; }
  .ts-wrap svg { width: 100%; height: auto; display: block; }
  .ts-grid { stroke: var(--rule); stroke-width: 1; }
  .ts-axis { font: 700 10px var(--mono); fill: var(--muted); }
  .ts-line { stroke: var(--muted); stroke-width: 1.5; opacity: .55; }
  .ts-line.ts-sean { stroke: var(--rust); stroke-width: 3; opacity: 1; }
  .ts-dot { fill: var(--rust); }
  .ts-key { color: var(--rust); font-weight: 800; }

  .status-chopped { color: var(--rust); font-weight: 800; text-transform: uppercase; font-size: 11px; letter-spacing: .06em; }
  .status-safe { color: var(--forest); font-weight: 800; text-transform: uppercase; font-size: 11px; letter-spacing: .06em; }

  @media (max-width: 760px) {
    .almanac-week-nav {
      grid-template-columns: 1fr 1fr;
    }

    .almanac-week-nav > div {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .almanac-week-nav h1 {
      font-size: 22px;
    }

    .odds-row { grid-template-columns: 90px 1fr 48px; }
  }
</style>
