---
import BaseLayout from '../../layouts/BaseLayout.astro';
import reviewData from '../../../public/data/weekly_reviews_dynasty.json';

export function getStaticPaths() {
  const data = reviewData as any;
  const weeks = (data.weeks || []).map((w: any) => ({
    params: { week: String(w.week) },
  }));
  // Always generate at least week 1 so the route exists
  if (weeks.length === 0) {
    weeks.push({ params: { week: '1' } });
  }
  return weeks;
}

const { week: weekParam } = Astro.params;
const weekNum = parseInt(weekParam || '1');
const data = reviewData as any;
const totalWeeks = data.total_weeks || 0;
const weekData = (data.weeks || []).find((w: any) => w.week === weekNum);
const isEmpty = !weekData;
const prevWeek = weekNum > 1 ? weekNum - 1 : null;
const nextWeek = weekNum < totalWeeks ? weekNum + 1 : null;

// Awards config
const awardConfig = [
  { key: 'top_scorer', icon: '🏆', title: 'Top Scorer', stat: (a: any) => `${a.points} pts` },
  { key: 'bust', icon: '💩', title: 'Bust of the Week', stat: (a: any) => `${a.points} pts` },
  { key: 'efficiency_king', icon: '👑', title: 'Efficiency King', stat: (a: any) => `${a.efficiency}%` },
  { key: 'overachiever', icon: '📈', title: 'Overachiever', stat: (a: any) => `Only ${a.missed} pts missed` },
  { key: 'underachiever', icon: '📉', title: 'Underachiever', stat: (a: any) => `${a.missed} pts left on table` },
  { key: 'bench_boss', icon: '💺', title: 'Bench Boss', stat: (a: any) => `${a.bench_points} bench pts` },
  { key: 'close_call', icon: '😰', title: 'Close Call', stat: (a: any) => `Won by ${a.margin} pts`, name: (a: any) => a.winner },
  { key: 'blowout', icon: '💥', title: 'Blowout', stat: (a: any) => `Won by ${a.margin} pts`, name: (a: any) => a.winner },
  { key: 'player_of_week', icon: '⭐', title: 'Player of the Week', stat: (a: any) => `${a.points} pts (${a.position})`, name: (a: any) => a.player_name, sub: (a: any) => `Rostered by ${a.owner}` },
  { key: 'faab_spender', icon: '💰', title: 'FAAB Big Spender', stat: (a: any) => `$${a.total_spent} spent` },
];

const awards = weekData?.awards || {};
const scoreboard = weekData?.scoreboard || [];
const allPlay = weekData?.all_play || [];
const faabActivity = weekData?.faab_activity || [];
const teamScores = weekData?.team_scores || [];
const faabWeekTotal = weekData?.faab_week_total || 0;

// Cumulative FAAB up to this week
const cumulativeFaab = (data.faab_summary?.cumulative_by_week || []).find((c: any) => c.week === weekNum);
---

<BaseLayout title={`Week ${weekNum} Review — Dynasty`}>
  <div class="review-container">

    <!-- Header with navigation -->
    <div class="review-header">
      <div class="week-nav">
        {prevWeek ? (
          <a href={`/weekly-review-dynasty/${prevWeek}`} class="nav-arrow">← Week {prevWeek}</a>
        ) : <span class="nav-arrow disabled">← Prev</span>}

        <div class="week-selector">
          <h1>🏈 Week {weekNum} Review</h1>
          <p class="subtitle">Dynasty League — {data.season || '2026'}</p>
          {totalWeeks > 1 && (
            <select id="weekJump" class="week-dropdown">
              {Array.from({ length: totalWeeks }, (_, i) => i + 1).map(w => (
                <option value={w} selected={w === weekNum}>Week {w}</option>
              ))}
            </select>
          )}
        </div>

        {nextWeek ? (
          <a href={`/weekly-review-dynasty/${nextWeek}`} class="nav-arrow">Week {nextWeek} →</a>
        ) : <span class="nav-arrow disabled">Next →</span>}
      </div>
    </div>

    {isEmpty ? (
      <div class="empty-state">
        <div class="empty-icon">📊</div>
        <h2>No Data for Week {weekNum}</h2>
        <p>This week hasn't been completed yet. Check back after games finish.</p>
      </div>
    ) : (
    <>
      <!-- Awards Grid -->
      <section class="section">
        <h2 class="section-title">🏅 Weekly Awards</h2>
        <div class="awards-grid">
          {awardConfig.map(cfg => {
            const award = awards[cfg.key];
            if (!award) return null;
            const displayName = cfg.name ? cfg.name(award) : award.owner_name;
            return (
              <div class="award-card">
                <div class="award-icon">{cfg.icon}</div>
                <div class="award-title">{cfg.title}</div>
                <div class="award-name">{displayName}</div>
                <div class="award-stat">{cfg.stat(award)}</div>
                {cfg.sub && <div class="award-sub">{cfg.sub(award)}</div>}
              </div>
            );
          })}
        </div>
      </section>

      <!-- H2H Scoreboard -->
      <section class="section">
        <h2 class="section-title">📋 Scoreboard</h2>
        <div class="matchups-grid">
          {scoreboard.map((m: any) => (
            <div class="matchup-card">
              <div class="matchup-team winner">
                <span class="team-name">{m.winner?.owner_name}</span>
                <span class="team-score">{m.winner?.points?.toFixed(1)}</span>
                <span class="win-badge">W</span>
              </div>
              <div class="matchup-vs">
                <span class="margin-label">{m.margin?.toFixed(1)} pt margin</span>
              </div>
              <div class="matchup-team loser">
                <span class="team-name">{m.loser?.owner_name}</span>
                <span class="team-score">{m.loser?.points?.toFixed(1)}</span>
                <span class="loss-badge">L</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- All-Play Rankings -->
      <section class="section">
        <h2 class="section-title">📊 All-Play Rankings</h2>
        <p class="section-sub">How each team would have done against every other team this week</p>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Team</th>
                <th>Points</th>
                <th>All-Play W</th>
                <th>All-Play L</th>
                <th>All-Play %</th>
              </tr>
            </thead>
            <tbody>
              {allPlay.map((t: any, i: number) => {
                const total = t.all_play_wins + t.all_play_losses + t.all_play_ties;
                const pct = total > 0 ? ((t.all_play_wins / total) * 100).toFixed(0) : '0';
                return (
                  <tr>
                    <td style="text-align:center; font-weight:bold;">{i + 1}</td>
                    <td style="font-weight:600;">{t.owner_name}</td>
                    <td style="text-align:center;">{t.points?.toFixed(1)}</td>
                    <td style="text-align:center; color:#4CAF50; font-weight:bold;">{t.all_play_wins}</td>
                    <td style="text-align:center; color:#f44336;">{t.all_play_losses}</td>
                    <td style="text-align:center; font-weight:bold;">{pct}%</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>

      <!-- FAAB Activity -->
      <section class="section">
        <h2 class="section-title">💰 FAAB Activity</h2>
        <div class="faab-summary-cards">
          <div class="faab-card">
            <div class="faab-card-value">{'$'}{faabWeekTotal}</div>
            <div class="faab-card-label">Spent This Week</div>
          </div>
          <div class="faab-card">
            <div class="faab-card-value">{faabActivity.length}</div>
            <div class="faab-card-label">Transactions</div>
          </div>
          {cumulativeFaab && (
            <div class="faab-card">
              <div class="faab-card-value">{'$'}{cumulativeFaab.cumulative}</div>
              <div class="faab-card-label">League Total (Season)</div>
            </div>
          )}
        </div>
        {faabActivity.length > 0 ? (
          <div class="table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Owner</th>
                  <th>Added</th>
                  <th>Dropped</th>
                  <th>Bid</th>
                </tr>
              </thead>
              <tbody>
                {faabActivity.map((txn: any) => (
                  <tr>
                    <td style="font-weight:600;">{txn.owner}</td>
                    <td>
                      {(txn.added || []).map((p: any) => (
                        <span class="player-add">+ {p.player_name} <span class="pos-badge">{p.position}</span></span>
                      ))}
                    </td>
                    <td>
                      {(txn.dropped || []).map((p: any) => (
                        <span class="player-drop">- {p.player_name} <span class="pos-badge">{p.position}</span></span>
                      ))}
                    </td>
                    <td style="text-align:center; font-weight:bold; color:#667eea;">{'$'}{txn.bid}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="no-data">No FAAB transactions this week</p>
        )}
      </section>

      <!-- Team Scores Breakdown -->
      <section class="section">
        <h2 class="section-title">📈 Full Standings This Week</h2>
        <div class="table-wrapper">
          <table class="data-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Team</th>
                <th>Score</th>
                <th>Optimal</th>
                <th>Efficiency</th>
                <th>Bench Pts</th>
              </tr>
            </thead>
            <tbody>
              {teamScores.map((t: any, i: number) => (
                <tr>
                  <td style="text-align:center; font-weight:bold;">{i + 1}</td>
                  <td style="font-weight:600;">{t.owner_name}</td>
                  <td style="text-align:center; font-weight:bold;">{t.points?.toFixed(1)}</td>
                  <td style="text-align:center;">{t.optimal?.toFixed(1)}</td>
                  <td style={`text-align:center; color:${t.efficiency >= 90 ? '#4CAF50' : t.efficiency >= 75 ? '#FF9800' : '#f44336'}; font-weight:bold;`}>{t.efficiency}%</td>
                  <td style="text-align:center;">{t.bench_points?.toFixed(1)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
    )}
  </div>

  <script>
    const dropdown = document.getElementById('weekJump') as HTMLSelectElement;
    if (dropdown) {
      dropdown.addEventListener('change', () => {
        window.location.href = `/weekly-review-dynasty/${dropdown.value}`;
      });
    }
  </script>

  <style>
    .review-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px;
    }
    .review-header {
      text-align: center;
      margin-bottom: 30px;
    }
    .week-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      background: rgba(255,255,255,0.95);
      border-radius: 16px;
      padding: 20px 30px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .nav-arrow {
      color: #667eea;
      text-decoration: none;
      font-weight: 600;
      font-size: 16px;
      padding: 8px 16px;
      border-radius: 8px;
      transition: background 0.2s;
    }
    .nav-arrow:hover { background: rgba(102,126,234,0.1); }
    .nav-arrow.disabled { color: #ccc; pointer-events: none; }
    .week-selector h1 { font-size: 28px; margin: 0; color: #2c3e50; }
    .subtitle { color: #888; margin-top: 4px; }
    .week-dropdown {
      margin-top: 8px;
      padding: 6px 12px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 14px;
      cursor: pointer;
    }
    .empty-state {
      text-align: center;
      background: rgba(255,255,255,0.95);
      border-radius: 16px;
      padding: 60px 30px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .empty-icon { font-size: 48px; margin-bottom: 16px; }
    .section {
      background: rgba(255,255,255,0.95);
      border-radius: 16px;
      padding: 25px;
      margin-bottom: 25px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .section-title {
      font-size: 22px;
      color: #2c3e50;
      margin-bottom: 15px;
      padding-bottom: 10px;
      border-bottom: 2px solid #f0f0f0;
    }
    .section-sub { color: #888; margin-bottom: 15px; font-size: 14px; }

    /* Awards */
    .awards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 15px;
    }
    .award-card {
      background: linear-gradient(135deg, #f8f9ff 0%, #f0f2ff 100%);
      border-radius: 12px;
      padding: 18px;
      text-align: center;
      border: 1px solid #e8ebff;
      transition: transform 0.2s;
    }
    .award-card:hover { transform: translateY(-3px); }
    .award-icon { font-size: 32px; margin-bottom: 8px; }
    .award-title { font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
    .award-name { font-size: 16px; font-weight: 700; color: #2c3e50; margin: 6px 0; }
    .award-stat { font-size: 14px; color: #667eea; font-weight: 600; }
    .award-sub { font-size: 12px; color: #999; margin-top: 4px; }

    /* Scoreboard */
    .matchups-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 15px;
    }
    .matchup-card {
      background: #f8f9ff;
      border-radius: 12px;
      padding: 15px;
      border: 1px solid #e8ebff;
    }
    .matchup-team {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
    }
    .team-name { flex: 1; font-weight: 600; }
    .team-score { font-size: 20px; font-weight: 700; }
    .win-badge {
      background: #4CAF50;
      color: white;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 700;
    }
    .loss-badge {
      background: #f44336;
      color: white;
      padding: 2px 8px;
      border-radius: 4px;
      font-size: 12px;
      font-weight: 700;
    }
    .matchup-vs {
      text-align: center;
      padding: 4px 0;
      border-top: 1px solid #e8ebff;
      border-bottom: 1px solid #e8ebff;
      margin: 4px 0;
    }
    .margin-label { font-size: 12px; color: #888; font-weight: 600; }

    /* Tables */
    .table-wrapper { overflow-x: auto; }
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    .data-table th {
      background: #f5f6fa;
      padding: 10px 12px;
      text-align: left;
      font-weight: 600;
      color: #555;
      border-bottom: 2px solid #e8ebff;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .data-table td {
      padding: 10px 12px;
      border-bottom: 1px solid #f0f0f0;
    }
    .data-table tbody tr:hover { background: #f8f9ff; }

    /* FAAB */
    .faab-summary-cards {
      display: flex;
      gap: 15px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .faab-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 18px 24px;
      border-radius: 12px;
      flex: 1;
      min-width: 150px;
      text-align: center;
    }
    .faab-card-value { font-size: 28px; font-weight: 700; }
    .faab-card-label { font-size: 12px; opacity: 0.85; margin-top: 4px; text-transform: uppercase; letter-spacing: 1px; }
    .player-add { color: #4CAF50; display: block; }
    .player-drop { color: #f44336; display: block; }
    .pos-badge {
      background: #e8ebff;
      color: #667eea;
      padding: 1px 6px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      margin-left: 4px;
    }
    .no-data {
      text-align: center;
      color: #999;
      padding: 20px;
      font-style: italic;
    }

    @media (max-width: 768px) {
      .review-container { padding: 10px; }
      .week-nav { flex-direction: column; gap: 10px; padding: 15px; }
      .week-selector h1 { font-size: 22px; }
      .nav-arrow { font-size: 14px; padding: 6px 12px; }
      .awards-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .award-card { padding: 12px 8px; }
      .award-icon { font-size: 26px; margin-bottom: 5px; }
      .award-title { font-size: 10px; letter-spacing: 0.5px; }
      .award-name { font-size: 13px; margin: 4px 0; word-break: break-word; }
      .award-stat { font-size: 12px; }
      .award-sub { font-size: 11px; }
      .matchups-grid { grid-template-columns: 1fr; }
      .matchup-card { padding: 12px; }
      .team-score { font-size: 17px; }
      .section { padding: 15px; margin-bottom: 15px; }
      .section-title { font-size: 18px; margin-bottom: 10px; }
      .faab-summary-cards { flex-direction: column; }
      .faab-card { padding: 14px 16px; min-width: unset; }
      .faab-card-value { font-size: 22px; }
      .data-table { font-size: 12px; min-width: 500px; }
      .data-table th, .data-table td { padding: 8px 6px; }
    }

    @media (max-width: 400px) {
      .review-container { padding: 6px; }
      .week-nav { padding: 12px 10px; }
      .week-selector h1 { font-size: 18px; }
      .awards-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
      .award-card { padding: 10px 6px; }
      .award-icon { font-size: 22px; margin-bottom: 4px; }
      .award-title { font-size: 9px; }
      .award-name { font-size: 12px; }
      .award-stat { font-size: 11px; }
      .section { padding: 12px; }
      .section-title { font-size: 16px; }
      .team-name { font-size: 13px; }
      .team-score { font-size: 15px; }
    }
  </style>
</BaseLayout>
