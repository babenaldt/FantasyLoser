---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlmanacWeek from '../../components/prototypes/AlmanacWeek.astro';
import reviewData from '../../../public/data/weekly_reviews_dynasty.json';

export function getStaticPaths() {
  const weeks = ((reviewData as any).weeks || []).map((week: any) => ({
    params: { week: String(week.week) },
  }));
  if (!weeks.length) weeks.push({ params: { week: '1' } });
  return weeks;
}

const weekNum = Number(Astro.params.week || 1);
---

<BaseLayout title={`Week ${weekNum} Review — Dynasty`}>
  <AlmanacWeek weekNum={weekNum} data={reviewData as any} />
</BaseLayout>
