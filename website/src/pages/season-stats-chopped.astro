---
import BaseLayout from '../layouts/BaseLayout.astro';
import leagueData from '../../public/data/season_stats_chopped.json';
import userLineupsData from '../../public/data/user_lineups_chopped.json';
import weeklyReviewData from '../../public/data/weekly_reviews_chopped.json';

const { league_name, season, teams, current_week, best_theoretical_lineups, avg_best_theoretical_lineup } = leagueData;

// Build a set of user names that have lineup pages
const slugify = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const userLineupUsers = (userLineupsData.users || []).map((u: any) => slugify(u.user_name));
const hasUserPage = (ownerName: string) => userLineupUsers.includes(slugify(ownerName));

// Preseason detection: no active week on Sleeper
const isPreseason = !teams || teams.length === 0 || (!current_week || current_week <= 0);

// Has at least one completed week of data — show everything when true
const hasCompletedWeeks = teams && teams.length > 0 && teams.some(t => (t.weeks_played || 0) > 0);

// Filter teams
const activeTeams = teams.filter(t => t.weeks_played > 0);
const qualifiedTeams = teams.filter(t => t.weeks_played >= 5);

// Sort teams by total points (default)
const sortedTeams = [...teams].sort((a, b) => b.total_points_scored - a.total_points_scored);

// Prepare chart data (All teams)
const chartTeams = sortedTeams;
const weeks = chartTeams[0]?.weekly_scores.map(w => w.week) || [];
const chartColors = [
  '#36a2eb', '#ff6384', '#4bc0c0', '#ff9f40', '#9966ff', '#ffcd56',
  '#c9cbcf', '#ff69b4', '#008080', '#a52a2a', '#000080', '#808000'
];

// Summary Stats (guard against empty/preseason data)
const avgPPG = teams.length ? teams.reduce((sum, t) => sum + (t.avg_points_per_game || 0), 0) / teams.length : 0;
const highestEfficiency = teams.length ? Math.max(...teams.map(t => t.efficiency_rate || 0)) : 0;
const totalBenchPoints = teams.reduce((sum, t) => sum + (t.points_left_on_bench || 0), 0);
const maxFAAB = 150;
const mostFAABRemaining = teams.length ? Math.max(...teams.map(t => maxFAAB - (t.faab_spent || 0))) : maxFAAB;
const activeForTheoretical = teams.filter(t => t.weeks_played > 0);
const bestTheoreticalAvg = activeForTheoretical.length ? Math.max(...activeForTheoretical.map(t => t.total_optimal_points / t.weeks_played)) : 0;

// Awards (Qualified Teams: >= 5 weeks)
const highestScorer = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.total_points_scored > current.total_points_scored) ? prev : current) : null;
const bestManager = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.efficiency_rate > current.efficiency_rate) ? prev : current) : null;
const mostConsistent = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.consistency_score > current.consistency_score) ? prev : current) : null;
const benchWarmer = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.points_left_on_bench > current.points_left_on_bench) ? prev : current) : null;
const waiverWizard = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.points_per_faab > current.points_per_faab) ? prev : current) : null;
const validWaiverWizard = waiverWizard && waiverWizard.points_per_faab > 0 ? waiverWizard : null;

const livingOnEdge = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.avg_safety_margin < current.avg_safety_margin) ? prev : current) : null;

const dangerZone = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.close_calls > current.close_calls) ? prev : current) : null;
const validDangerZone = dangerZone && dangerZone.close_calls > 0 ? dangerZone : null;

const boomOrBust = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.consistency_score < current.consistency_score) ? prev : current) : null;
const mostAverage = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => 
    (Math.abs(prev.avg_points_per_game - avgPPG) < Math.abs(current.avg_points_per_game - avgPPG)) ? prev : current
) : null;

// Awards (Active Teams: > 0 weeks)
const highestAvgScore = activeTeams.length ? activeTeams.reduce((prev, current) => (prev.avg_points_per_game > current.avg_points_per_game) ? prev : current) : null;

// Weekly Awards (Exclude current week if in progress)
let highestWeeklyScore = { score: -1, owner: '', week: 0 };
let lowestWeeklyScore = { score: 9999, owner: '', week: 0 };

activeTeams.forEach(t => {
    t.weekly_scores.forEach(w => {
        // Skip current week for awards
        if (w.week >= current_week) return;

        if (w.points > highestWeeklyScore.score) {
            highestWeeklyScore = { score: w.points, owner: t.owner_name, week: w.week };
        }
        if (w.points < lowestWeeklyScore.score && w.points > 0) {
            lowestWeeklyScore = { score: w.points, owner: t.owner_name, week: w.week };
        }
    });
});

// Unluckiest Chop Logic
let unluckiestChop = { owner: '', diff: 9999, elimScore: 0, leagueAvg: 0, week: 0 };

teams.forEach(t => {
    if (t.eliminated_week) {
        const elimWeek = t.eliminated_week;
        const elimScoreObj = t.weekly_scores.find(w => w.week === elimWeek);
        if (elimScoreObj) {
            const elimScore = elimScoreObj.points;
            
            if (elimScore > 0) {
                // Calculate league average for that week (excluding 0s)
                let weekSum = 0;
                let weekCount = 0;
                teams.forEach(otherTeam => {
                    const wScore = otherTeam.weekly_scores.find(w => w.week === elimWeek);
                    if (wScore && wScore.points > 0) {
                        weekSum += wScore.points;
                        weekCount++;
                    }
                });
                
                if (weekCount > 0) {
                    const leagueAvg = weekSum / weekCount;
                    const diff = Math.abs(elimScore - leagueAvg);
                    
                    if (diff < unluckiestChop.diff) {
                        unluckiestChop = { 
                            owner: t.owner_name, 
                            diff: diff, 
                            elimScore: elimScore, 
                            leagueAvg: leagueAvg, 
                            week: elimWeek 
                        };
                    }
                }
            }
        }
    }
});

// Projection Awards
const projectionBeater = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => 
    ((prev.projection_beat_pct || 0) > (current.projection_beat_pct || 0)) ? prev : current) : null;
const validProjectionBeater = projectionBeater && (projectionBeater.projection_beat_pct || 0) > 0 ? projectionBeater : null;

const crystalBallTeams = qualifiedTeams.filter(t => (t.avg_abs_projection_delta || 999) < 999);
const crystalBall = crystalBallTeams.length ? crystalBallTeams.reduce((prev, current) => 
    ((prev.avg_abs_projection_delta || 999) < (current.avg_abs_projection_delta || 999)) ? prev : current) : null;
const validCrystalBall = crystalBall && (crystalBall.avg_abs_projection_delta || 0) > 0 ? crystalBall : null;

// FAAB Tracker data
const faabReview = weeklyReviewData as any;
const faabSummary = faabReview.faab_summary || {};
const faabByTeam = faabSummary.by_team || [];
const faabCumulative = faabSummary.cumulative_by_week || [];
const faabTopMoves = faabSummary.top_moves || [];
const totalLeagueBudget = faabSummary.total_league_budget || 0;
const totalLeagueSpent = faabSummary.total_league_spent || 0;
const biggestBid = faabTopMoves.length > 0 ? faabTopMoves[0].bid : 0;
const avgPerTeam = faabByTeam.length > 0 ? Math.round(totalLeagueSpent / faabByTeam.length) : 0;

// Weekly Review data for links
const reviewWeeks = (weeklyReviewData as any).weeks || [];
const latestReviewWeek = reviewWeeks.length > 0 ? reviewWeeks[reviewWeeks.length - 1].week : 1;

// All FAAB player acquisitions (flattened from weekly data)
const allMoves: any[] = reviewWeeks.flatMap((w: any) => 
  (w.faab_activity || []).flatMap((txn: any) => 
    (txn.added || []).map((p: any) => ({
      week: w.week,
      player_name: p.player_name,
      position: p.position,
      bid: txn.bid,
      owner: txn.owner,
      dropped: (txn.dropped || []).map((d: any) => d.player_name).join(', ')
    }))
  )
).sort((a: any, b: any) => b.bid - a.bid);

// Separate active vs eliminated teams for FAAB
const eliminatedOwners = new Set(teams.filter((t: any) => t.eliminated_week).map((t: any) => t.owner_name));
const activeFaabTeams = faabByTeam.filter((t: any) => !eliminatedOwners.has(t.owner_name));
const eliminatedFaabTeams = faabByTeam.filter((t: any) => eliminatedOwners.has(t.owner_name));

// Group FAAB moves by week
const faabMovesByWeek: { week: number; moves: any[]; weekTotal: number }[] = [];
const movesByW = new Map<number, any[]>();
for (const m of allMoves) {
  if (!movesByW.has(m.week)) movesByW.set(m.week, []);
  movesByW.get(m.week)!.push(m);
}
for (const [week, moves] of [...movesByW.entries()].sort((a, b) => a[0] - b[0])) {
  faabMovesByWeek.push({ week, moves: moves.sort((a: any, b: any) => b.bid - a.bid), weekTotal: moves.reduce((s: number, m: any) => s + m.bid, 0) });
}
---

<BaseLayout title={`${league_name} - Season Stats`} bodyClass="chopped-stats-page">
  <div class="page-header">
    <h1>{league_name}</h1>
    <p class="subtitle">{season} Season Statistics</p>
    {!isPreseason && (
      <a href="/weekly-review-chopped/1" style="display:inline-block; margin-top:10px; padding:8px 20px; background:rgba(255,255,255,0.2); color:white; border-radius:8px; text-decoration:none; font-weight:500;">Weekly Reviews</a>
    )}
  </div>

  {isPreseason && (
  <div class="season-status-banner" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 20px 24px; border-radius: 12px; margin: 0 auto 24px; max-width: 900px; text-align: center; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);">
    <div style="font-size: 1.3em; font-weight: 700; margin-bottom: 6px;">Preseason</div>
    <div style="opacity: 0.9;">The {season} season hasn't started yet. Stats will populate once games begin.</div>
  </div>
  )}

  {!isPreseason && !hasCompletedWeeks && (
  <div class="season-status-banner" style="background: linear-gradient(135deg, #38a169 0%, #2f855a 100%); color: white; padding: 20px 24px; border-radius: 12px; margin: 0 auto 24px; max-width: 900px; text-align: center; box-shadow: 0 4px 15px rgba(56, 161, 105, 0.3);">
    <div style="font-size: 1.3em; font-weight: 700; margin-bottom: 6px;">Week {current_week} In Progress</div>
    <div style="opacity: 0.9;">Games are underway! Stats below will update once the week completes.</div>
  </div>
  )}

  {!isPreseason && (
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-title">League Average PPG</div>
      <div class="stat-value">{avgPPG.toFixed(1)}</div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Highest Efficiency</div>
      <div class="stat-value">{highestEfficiency.toFixed(1)}%</div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Total Bench Points</div>
      <div class="stat-value">{totalBenchPoints.toFixed(0)}</div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Most FAAB Remaining</div>
      <div class="stat-value">{'$'}{mostFAABRemaining}</div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Best Theoretical Avg</div>
      <div class="stat-value">{bestTheoreticalAvg.toFixed(1)}</div>
    </div>
  </div>
  )}

  {!isPreseason && (
  <div class="table-container">
    <h3 style="margin-bottom: 15px; color: #2d3748;">Detailed Team Statistics</h3>
    <table class="stats-table" id="statsTable">
      <thead>
        <tr>
          <th onclick="sortTable(0)" title="Current elimination ranking">Rank</th>
          <th style="text-align: left;" onclick="sortTable(1)" title="Team owner name">Team Owner</th>
          <th onclick="sortTable(2)" title="Average points per game">Avg PPG</th>
          <th onclick="sortTable(3)" title="Average points above/below weekly projection">Proj +/-</th>
          <th onclick="sortTable(4)" title="Average margin above the eliminated team each week">Safety Margin</th>
          <th onclick="sortTable(5)" title="Number of weeks with margin ≤ 10 points">Close Calls</th>
          <th onclick="sortTable(6)" title="Percentage of optimal points achieved (Actual / Optimal)">Efficiency</th>
          <th onclick="sortTable(7)" title="Points scored by bench players (not in starting lineup)">Bench Pts</th>
          <th onclick="sortTable(8)" title="Points left on table (Optimal - Actual lineup)">Missed Pts</th>
          <th onclick="sortTable(9)" title="Consistency score (Mean / Std Dev) - higher is better">Consistency</th>
          <th onclick="sortTable(10)" title="FAAB dollars spent on waivers">FAAB Used</th>
          <th onclick="sortTable(11)" title="Points per FAAB dollar spent">Pt/$</th>
        </tr>
      </thead>
      <tbody id="tableBody">
        {sortedTeams.map((team, index) => (
          <tr>
            <td style="text-align: center;" data-value={index + 1}>{index + 1}</td>
            <td style="font-weight: 600;">
              {hasUserPage(team.owner_name) ? (
                <a href={`/users/chopped-${slugify(team.owner_name)}`} style="color: #667eea; text-decoration: none;">
                  {team.owner_name}
                </a>
              ) : (
                <span>{team.owner_name}</span>
              )}
            </td>
            <td style="text-align: center; font-weight: bold;" data-value={team.avg_points_per_game || 0}>{(team.avg_points_per_game || 0).toFixed(1)}</td>
            <td style={`text-align: center; color: ${(team.avg_projection_delta || 0) > 0 ? '#4CAF50' : (team.avg_projection_delta || 0) < 0 ? '#f44336' : '#888'}; font-weight: bold;`} data-value={team.avg_projection_delta || 0}>{(team.avg_projection_delta || 0) > 0 ? '+' : ''}{(team.avg_projection_delta || 0).toFixed(1)}</td>
            <td style="text-align: center;" data-value={team.avg_safety_margin || 0}>{(team.avg_safety_margin || 0).toFixed(1)}</td>
            <td style="text-align: center;" data-value={team.close_calls || 0}>{team.close_calls || 0}</td>
            <td style="text-align: center;" data-value={team.efficiency_rate || 0}>{(team.efficiency_rate || 0).toFixed(1)}%</td>
            <td style="text-align: center;" data-value={team.total_bench_points || 0}>{(team.total_bench_points || 0).toFixed(1)}</td>
            <td style="text-align: center;" data-value={team.points_left_on_bench || 0}>{(team.points_left_on_bench || 0).toFixed(1)}</td>
            <td style="text-align: center;" data-value={team.consistency_score || 0}>{(team.consistency_score || 0).toFixed(1)}</td>
            <td style="text-align: center;" data-value={team.faab_spent || 0}>{'$'}{team.faab_spent || 0}</td>
            <td style="text-align: center;" data-value={team.points_per_faab || 0}>{(team.points_per_faab || 0).toFixed(2)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  )}

  {!isPreseason && (
  <div class="awards-section">
    <h3 style="text-align: center; color: #2d3748; margin-bottom: 20px;">Season Awards</h3>
    <div class="awards-grid">
      {highestScorer && (
      <div class="award-card">
        <div class="award-icon">🏆</div>
        <div class="award-title">Highest Scorer</div>
        <div class="award-winner">{highestScorer.owner_name}</div>
        <div class="award-value">{highestScorer.total_points_scored.toFixed(1)} points</div>
      </div>
      )}
      {highestWeeklyScore.score > -1 && (
      <div class="award-card">
        <div class="award-icon">🔥</div>
        <div class="award-title">Highest Weekly Score</div>
        <div class="award-winner">{highestWeeklyScore.owner}</div>
        <div class="award-value">{highestWeeklyScore.score.toFixed(1)} pts (Week {highestWeeklyScore.week})</div>
      </div>
      )}
      {lowestWeeklyScore.score < 9999 && (
      <div class="award-card">
        <div class="award-icon">💩</div>
        <div class="award-title">Lowest Weekly Score</div>
        <div class="award-winner">{lowestWeeklyScore.owner}</div>
        <div class="award-value">{lowestWeeklyScore.score.toFixed(1)} pts (Week {lowestWeeklyScore.week})</div>
      </div>
      )}
      {highestAvgScore && (
      <div class="award-card">
        <div class="award-icon">⭐</div>
        <div class="award-title">Highest Average Score</div>
        <div class="award-winner">{highestAvgScore.owner_name}</div>
        <div class="award-value">{highestAvgScore.avg_points_per_game.toFixed(1)} ppg</div>
      </div>
      )}
      {bestManager && (
      <div class="award-card">
        <div class="award-icon">🎯</div>
        <div class="award-title">Best Manager</div>
        <div class="award-winner">{bestManager.owner_name}</div>
        <div class="award-value">{bestManager.efficiency_rate.toFixed(1)}% efficiency</div>
      </div>
      )}
      {unluckiestChop.owner && (
      <div class="award-card">
        <div class="award-icon">🪓</div>
        <div class="award-title">Unluckiest Chop</div>
        <div class="award-winner">{unluckiestChop.owner}</div>
        <div class="award-value">{unluckiestChop.elimScore.toFixed(1)} pts (Week {unluckiestChop.week})</div>
      </div>
      )}
      {livingOnEdge && (
      <div class="award-card">
        <div class="award-icon">🔪</div>
        <div class="award-title">Living on the Edge</div>
        <div class="award-winner">{livingOnEdge.owner_name}</div>
        <div class="award-value">{livingOnEdge.avg_safety_margin.toFixed(1)} avg margin</div>
      </div>
      )}
      {validDangerZone && (
      <div class="award-card">
        <div class="award-icon">⚠️</div>
        <div class="award-title">Danger Zone</div>
        <div class="award-winner">{validDangerZone.owner_name}</div>
        <div class="award-value">{validDangerZone.close_calls} close calls</div>
      </div>
      )}
      {boomOrBust && (
      <div class="award-card">
        <div class="award-icon">💥</div>
        <div class="award-title">Boom or Bust</div>
        <div class="award-winner">{boomOrBust.owner_name}</div>
        <div class="award-value">{boomOrBust.consistency_score.toFixed(2)} consistency</div>
      </div>
      )}
      {mostAverage && (
      <div class="award-card">
        <div class="award-icon">😐</div>
        <div class="award-title">Most Average Team</div>
        <div class="award-winner">{mostAverage.owner_name}</div>
        <div class="award-value">{mostAverage.avg_points_per_game.toFixed(1)} ppg</div>
      </div>
      )}
      {mostConsistent && (
      <div class="award-card">
        <div class="award-icon">📊</div>
        <div class="award-title">Most Consistent</div>
        <div class="award-winner">{mostConsistent.owner_name}</div>
        <div class="award-value">{mostConsistent.consistency_score.toFixed(2)} score</div>
      </div>
      )}
      {validWaiverWizard && (
      <div class="award-card">
        <div class="award-icon">🔮</div>
        <div class="award-title">Waiver Wire Wizard</div>
        <div class="award-winner">{validWaiverWizard.owner_name}</div>
        <div class="award-value">{validWaiverWizard.points_per_faab.toFixed(2)} Pt/$</div>
      </div>
      )}
      {benchWarmer && (
      <div class="award-card">
        <div class="award-icon">🪑</div>
        <div class="award-title">Bench Warmer</div>
        <div class="award-winner">{benchWarmer.owner_name}</div>
        <div class="award-value">{benchWarmer.points_left_on_bench.toFixed(1)} pts</div>
      </div>
      )}
      {validProjectionBeater && (
      <div class="award-card">
        <div class="award-icon">📈</div>
        <div class="award-title">Projection Beater</div>
        <div class="award-winner">{validProjectionBeater.owner_name}</div>
        <div class="award-value">{validProjectionBeater.projection_beat_pct.toFixed(0)}% of weeks above projection</div>
      </div>
      )}
      {validCrystalBall && (
      <div class="award-card">
        <div class="award-icon">🔮</div>
        <div class="award-title">Crystal Ball</div>
        <div class="award-winner">{validCrystalBall.owner_name}</div>
        <div class="award-value">Avg {validCrystalBall.avg_abs_projection_delta.toFixed(1)} pts from projection</div>
      </div>
      )}
    </div>
  </div>
  )}

  {!isPreseason && (
  <!-- Elimination Bracket Visualization -->
  <div class="elimination-bracket-section">
    <h2>Elimination Timeline</h2>
    <p class="subtitle">Watch the competition narrow week by week</p>
    
    <div class="bracket-container">
      {Array.from({ length: current_week - 1 }).map((_, weekIndex) => {
        const week = weekIndex + 1;
        const eliminated = teams.filter(t => t.eliminated_week === week);
        const remaining = teams.filter(t => !t.eliminated_week || t.eliminated_week > week).length;
        
        return (
          <div class="week-elimination">
            <div class="week-header">
              <div class="week-label">Week {week}</div>
              <div class="remaining-count">{remaining} remaining</div>
            </div>
            <div class="elimination-content">
              {eliminated.length > 0 ? (
                eliminated.map(team => {
                  const weekScore = team.weekly_scores.find(w => w.week === week);
                  return hasUserPage(team.owner_name) ? (
                      <a href={`/users/chopped-${slugify(team.owner_name)}`} class="eliminated-player">
                        <div class="player-name">{team.owner_name}</div>
                        <div class="elimination-score">{weekScore?.points.toFixed(1) || '0.0'} pts</div>
                        <div class="eliminated-badge">Chopped</div>
                      </a>
                    ) : (
                      <div class="eliminated-player">
                        <div class="player-name">{team.owner_name}</div>
                        <div class="elimination-score">{weekScore?.points.toFixed(1) || '0.0'} pts</div>
                        <div class="eliminated-badge">Chopped</div>
                      </div>
                    );
                })
              ) : (
                <div class="no-elimination">No eliminations</div>
              )}
            </div>
          </div>
        );
      })}
      
      <!-- Finals -->
      {current_week > 14 && teams.filter(t => !t.eliminated_week).length > 0 && (
        <div class="week-elimination finals">
          <div class="week-header finals-header">
            <div class="week-label">Finals</div>
            <div class="remaining-count">{teams.filter(t => !t.eliminated_week).length} finalists</div>
          </div>
          <div class="elimination-content finals-content">
            {teams.filter(t => !t.eliminated_week).map(team => 
              hasUserPage(team.owner_name) ? (
                <a href={`/users/chopped-${slugify(team.owner_name)}`} class="finalist">
                  <div class="player-name">{team.owner_name}</div>
                  <div class="finalist-stats">
                    <div>{(team.avg_points_per_game || 0).toFixed(1)} PPG</div>
                    <div>{(team.efficiency_rate || 0).toFixed(1)}% Eff</div>
                  </div>
                  <div class="finalist-badge">Finalist</div>
                </a>
              ) : (
                <div class="finalist">
                  <div class="player-name">{team.owner_name}</div>
                  <div class="finalist-stats">
