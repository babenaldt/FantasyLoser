---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlmanacWeekChopped from '../../components/prototypes/AlmanacWeekChopped.astro';
import reviewData from '../../../public/data/weekly_reviews_chopped.json';
import survivalData from '../../../public/data/chopped_survival_odds.json';

export function getStaticPaths() {
  const data = reviewData as any;
  const weekSet = new Set((data.weeks || []).map((w: any) => String(w.week)));
  // The survival sim covers the current (in-progress) week, which has no
  // review data yet — still generate its page so the odds are visible.
  const survivalWeek = (survivalData as any)?.week;
  if (survivalWeek) weekSet.add(String(survivalWeek));
  const weeks = [...weekSet].map((week) => ({ params: { week } }));
  if (weeks.length === 0) {
    weeks.push({ params: { week: '1' } });
  }
  return weeks;
}

const { week: weekParam } = Astro.params;
const weekNum = parseInt(weekParam || '1');
---

<BaseLayout title={`Week ${weekNum} Review — Chopped`}>
  <AlmanacWeekChopped weekNum={weekNum} data={reviewData as any} />
</BaseLayout>
