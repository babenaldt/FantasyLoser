---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import leagueData from '../../../../public/data/archive/2025/season_stats_chopped.json';
import archiveFaabMoves from '../../../../public/data/archive/2025/archive_faab_chopped_2025.json';

const { league_name, season, teams: rawTeams, current_week, best_theoretical_lineups, avg_best_theoretical_lineup, champion } = leagueData;

// Backfill properties that may be missing in older archived data
const teams = rawTeams.map(t => ({
    ...t,
    total_bench_points: t.total_bench_points ?? t.weekly_scores.reduce((sum, w) => sum + (w.bench || 0), 0),
}));

const activeTeams = teams.filter(t => t.weeks_played > 0);
const qualifiedTeams = teams.filter(t => t.weeks_played >= 5);

const sortedTeams = [...teams].sort((a, b) => b.total_points_scored - a.total_points_scored);

const chartTeams = sortedTeams;
const weeks = chartTeams[0]?.weekly_scores.map(w => w.week) || [];

const avgPPG = teams.reduce((sum, t) => sum + t.avg_points_per_game, 0) / teams.length;
const totalBenchPoints = teams.reduce((sum, t) => sum + t.total_bench_points, 0);
const maxFAAB = 150;
const mostFAABRemaining = Math.max(...teams.map(t => maxFAAB - t.faab_spent));

const highestScorer = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.total_points_scored > current.total_points_scored) ? prev : current) : null;
const mostConsistent = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.consistency_score > current.consistency_score) ? prev : current) : null;
const benchWarmer = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.total_bench_points > current.total_bench_points) ? prev : current) : null;
const waiverWizard = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.points_per_faab > current.points_per_faab) ? prev : current) : null;
const validWaiverWizard = waiverWizard && waiverWizard.points_per_faab > 0 ? waiverWizard : null;

const livingOnEdge = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.avg_safety_margin < current.avg_safety_margin) ? prev : current) : null;
const dangerZone = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.close_calls > current.close_calls) ? prev : current) : null;
const validDangerZone = dangerZone && dangerZone.close_calls > 0 ? dangerZone : null;
const boomOrBust = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => (prev.consistency_score < current.consistency_score) ? prev : current) : null;
const mostAverage = qualifiedTeams.length ? qualifiedTeams.reduce((prev, current) => 
    (Math.abs(prev.avg_points_per_game - avgPPG) < Math.abs(current.avg_points_per_game - avgPPG)) ? prev : current
) : null;

const highestAvgScore = activeTeams.length ? activeTeams.reduce((prev, current) => (prev.avg_points_per_game > current.avg_points_per_game) ? prev : current) : null;

let highestWeeklyScore = { score: -1, owner: '', week: 0 };
let lowestWeeklyScore = { score: 9999, owner: '', week: 0 };

activeTeams.forEach(t => {
    t.weekly_scores.forEach(w => {
        if (w.points > highestWeeklyScore.score) {
            highestWeeklyScore = { score: w.points, owner: t.owner_name, week: w.week };
        }
        if (w.points < lowestWeeklyScore.score && w.points > 0) {
            lowestWeeklyScore = { score: w.points, owner: t.owner_name, week: w.week };
        }
    });
});

// Championship data
const championTeam = champion ? teams.find(t => t.owner_name === champion.owner_name) : null;
const runnerUpTeam = champion ? teams.find(t => t.owner_name === champion.runner_up) : null;

let unluckiestChop = { owner: '', diff: 9999, elimScore: 0, leagueAvg: 0, week: 0 };
teams.forEach(t => {
    if (t.eliminated_week) {
        const elimWeek = t.eliminated_week;
        const elimScoreObj = t.weekly_scores.find(w => w.week === elimWeek);
        if (elimScoreObj) {
            const elimScore = elimScoreObj.points;
            if (elimScore > 0) {
                let weekSum = 0;
                let weekCount = 0;
                teams.forEach(otherTeam => {
                    const wScore = otherTeam.weekly_scores.find(w => w.week === elimWeek);
                    if (wScore && wScore.points > 0) {
                        weekSum += wScore.points;
                        weekCount++;
                    }
                });
                if (weekCount > 0) {
                    const leagueAvg = weekSum / weekCount;
                    const diff = Math.abs(elimScore - leagueAvg);
                    if (diff < unluckiestChop.diff) {
                        unluckiestChop = { owner: t.owner_name, diff: diff, elimScore: elimScore, leagueAvg: leagueAvg, week: elimWeek };
                    }
                }
            }
        }
    }
});

// FAAB Tracker data computed from archived weekly_scores
const faabByTeam = teams
  .map(t => ({
    owner_name: t.owner_name,
    spent: t.faab_spent || 0,
    remaining: maxFAAB - (t.faab_spent || 0),
    moves: t.waiver_moves || 0,
  }))
  .sort((a, b) => b.spent - a.spent);

const totalLeagueSpent = faabByTeam.reduce((sum, t) => sum + t.spent, 0);
const totalLeagueBudget = faabByTeam.length * maxFAAB;
const biggestSpender = faabByTeam.length > 0 ? faabByTeam[0] : null;
const avgPerTeam = faabByTeam.length > 0 ? Math.round(totalLeagueSpent / faabByTeam.length) : 0;

const maxWeeks = Math.max(...teams.map(t => t.weekly_scores.length));
const faabCumulative: { week: number; spent: number; cumulative: number }[] = [];
let runningTotal = 0;
for (let w = 0; w < maxWeeks; w++) {
  const weekSpent = teams.reduce((sum, t) => {
    const ws = t.weekly_scores[w];
    return sum + (ws?.faab_spent || 0);
  }, 0);
  runningTotal += weekSpent;
  if (weekSpent > 0 || runningTotal > 0) {
    faabCumulative.push({ week: w + 1, spent: weekSpent, cumulative: runningTotal });
  }
}

// Group FAAB moves by week
const faabMovesByWeek: { week: number; moves: any[]; weekTotal: number }[] = [];
const movesByW = new Map<number, any[]>();
for (const m of (archiveFaabMoves as any[])) {
  if (!movesByW.has(m.week)) movesByW.set(m.week, []);
  movesByW.get(m.week)!.push(m);
}
for (const [week, moves] of [...movesByW.entries()].sort((a, b) => a[0] - b[0])) {
  faabMovesByWeek.push({ week, moves: moves.sort((a: any, b: any) => b.bid - a.bid), weekTotal: moves.reduce((s: number, m: any) => s + m.bid, 0) });
}
---

<BaseLayout title={`${league_name} - ${season} Season Archive`} bodyClass="archive-page archive-chopped-page">
  <div class="archive-banner">
    <span>Archived Season - {season}</span>
    <div class="archive-banner-links">
      <a href="/archive/2025/season-stats-dynasty">2025 Dynasty</a>
      <a href="/season-stats-chopped">View Current Season &rarr;</a>
    </div>
  </div>

  <div class="page-header">
    <h1>{league_name}</h1>
    <p class="subtitle">{season} Season Statistics (Archived)</p>
  </div>

  {championTeam && (
  <div class="championship-section">
    <div class="trophy-icon">🏆</div>
    <h2 class="champ-title">{season} Chopped League Champion</h2>
    <div class="champ-name">{championTeam.owner_name}</div>
    <div class="champ-stats">
      <span>{championTeam.total_points_scored.toFixed(1)} total pts</span>
      <span>{championTeam.avg_points_per_game.toFixed(1)} PPG</span>
      <span>{championTeam.weeks_played} weeks survived</span>
    </div>
    {champion.champion_score && (
      <div class="champ-matchup">
        Championship (Week {champion.championship_week}): {champion.champion_score} - {champion.runner_up_score}
      </div>
    )}
    {runnerUpTeam && (
      <div class="runner-up">
        Runner-Up: <strong>{runnerUpTeam.owner_name}</strong> ({runnerUpTeam.total_points_scored.toFixed(1)} pts)
      </div>
    )}
  </div>
  )}

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-title">League Average PPG</div>
      <div class="stat-value">{avgPPG.toFixed(1)}</div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Highest Weekly Score</div>
      <div class="stat-value">{highestWeeklyScore.score > 0 ? highestWeeklyScore.score.toFixed(1) : 'N/A'}</div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Total Bench Points</div>
      <div class="stat-value">{totalBenchPoints.toFixed(0)}</div>
    </div>
    <div class="stat-card">
      <div class="stat-title">Most FAAB Remaining</div>
      <div class="stat-value">{'$'}{mostFAABRemaining}</div>
    </div>
  </div>

  <div class="table-container">
    <h3 style="margin-bottom: 15px; color: #2d3748;">Detailed Team Statistics</h3>
    <table class="stats-table" id="statsTable">
      <thead>
        <tr>
          <th onclick="sortTable(0)" title="Current elimination ranking">Rank</th>
          <th style="text-align: left;" onclick="sortTable(1)" title="Team owner name">Team Owner</th>
          <th onclick="sortTable(2)" title="Average points per game">Avg PPG</th>
          <th onclick="sortTable(3)" title="Average margin above the eliminated team each week">Safety Margin</th>
          <th onclick="sortTable(4)" title="Number of weeks with margin <= 10 points">Close Calls</th>
          <th onclick="sortTable(5)" title="Points scored by bench players (not in starting lineup)">Bench Pts</th>
          <th onclick="sortTable(6)" title="Consistency score (Mean / Std Dev) - higher is better">Consistency</th>
          <th onclick="sortTable(7)" title="FAAB dollars spent on waivers">FAAB Used</th>
          <th onclick="sortTable(8)" title="Points per FAAB dollar spent">Pt/$</th>
        </tr>
      </thead>
      <tbody id="tableBody">
        {sortedTeams.map((team, index) => (
          <tr>
            <td style="text-align: center;" data-value={index + 1}>{index + 1}</td>
            <td style="font-weight: 600;">{team.owner_name}</td>
            <td style="text-align: center; font-weight: bold;" data-value={team.avg_points_per_game}>{team.avg_points_per_game.toFixed(1)}</td>
            <td style="text-align: center;" data-value={team.avg_safety_margin}>{team.avg_safety_margin.toFixed(1)}</td>
            <td style="text-align: center;" data-value={team.close_calls}>{team.close_calls}</td>
            <td style="text-align: center;" data-value={team.total_bench_points}>{team.total_bench_points.toFixed(1)}</td>
            <td style="text-align: center;" data-value={team.consistency_score}>{team.consistency_score.toFixed(1)}</td>
            <td style="text-align: center;" data-value={team.faab_spent}>${team.faab_spent}</td>
            <td style="text-align: center;" data-value={team.points_per_faab}>{team.points_per_faab.toFixed(2)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="awards-section">
    <h3 style="text-align: center; color: #2d3748; margin-bottom: 20px;">Season Awards</h3>
    <div class="awards-grid">
      {highestScorer && (
      <div class="award-card">
        <div class="award-icon">🏆</div>
        <div class="award-title">Highest Scorer</div>
        <div class="award-winner">{highestScorer.owner_name}</div>
        <div class="award-value">{highestScorer.total_points_scored.toFixed(1)} points</div>
      </div>
      )}
      {highestWeeklyScore.score > -1 && (
      <div class="award-card">
        <div class="award-icon">🔥</div>
        <div class="award-title">Highest Weekly Score</div>
        <div class="award-winner">{highestWeeklyScore.owner}</div>
        <div class="award-value">{highestWeeklyScore.score.toFixed(1)} pts (Week {highestWeeklyScore.week})</div>
      </div>
      )}
      {lowestWeeklyScore.score < 9999 && (
      <div class="award-card">
        <div class="award-icon">💩</div>
        <div class="award-title">Lowest Weekly Score</div>
        <div class="award-winner">{lowestWeeklyScore.owner}</div>
        <div class="award-value">{lowestWeeklyScore.score.toFixed(1)} pts (Week {lowestWeeklyScore.week})</div>
      </div>
      )}
      {highestAvgScore && (
      <div class="award-card">
        <div class="award-icon">⭐</div>
        <div class="award-title">Highest Average Score</div>
        <div class="award-winner">{highestAvgScore.owner_name}</div>
        <div class="award-value">{highestAvgScore.avg_points_per_game.toFixed(1)} ppg</div>
      </div>
      )}
      {unluckiestChop.owner && (
      <div class="award-card">
        <div class="award-icon">🪓</div>
        <div class="award-title">Unluckiest Chop</div>
        <div class="award-winner">{unluckiestChop.owner}</div>
        <div class="award-value">{unluckiestChop.elimScore.toFixed(1)} pts (Week {unluckiestChop.week})</div>
      </div>
      )}
      {livingOnEdge && (
      <div class="award-card">
        <div class="award-icon">🔪</div>
        <div class="award-title">Living on the Edge</div>
        <div class="award-winner">{livingOnEdge.owner_name}</div>
        <div class="award-value">{livingOnEdge.avg_safety_margin.toFixed(1)} avg margin</div>
      </div>
      )}
      {validDangerZone && (
      <div class="award-card">
        <div class="award-icon">⚠️</div>
        <div class="award-title">Danger Zone</div>
        <div class="award-winner">{validDangerZone.owner_name}</div>
        <div class="award-value">{validDangerZone.close_calls} close calls</div>
      </div>
      )}
      {boomOrBust && (
      <div class="award-card">
        <div class="award-icon">💥</div>
        <div class="award-title">Boom or Bust</div>
        <div class="award-winner">{boomOrBust.owner_name}</div>
        <div class="award-value">{boomOrBust.consistency_score.toFixed(2)} consistency</div>
      </div>
      )}
      {mostAverage && (
      <div class="award-card">
        <div class="award-icon">😐</div>
        <div class="award-title">Most Average Team</div>
        <div class="award-winner">{mostAverage.owner_name}</div>
        <div class="award-value">{mostAverage.avg_points_per_game.toFixed(1)} ppg</div>
      </div>
      )}
      {mostConsistent && (
      <div class="award-card">
        <div class="award-icon">📊</div>
        <div class="award-title">Most Consistent</div>
        <div class="award-winner">{mostConsistent.owner_name}</div>
        <div class="award-value">{mostConsistent.consistency_score.toFixed(2)} score</div>
      </div>
      )}
      {validWaiverWizard && (
      <div class="award-card">
        <div class="award-icon">🔮</div>
        <div class="award-title">Waiver Wire Wizard</div>
        <div class="award-winner">{validWaiverWizard.owner_name}</div>
        <div class="award-value">{validWaiverWizard.points_per_faab.toFixed(2)} Pt/$</div>
      </div>
      )}
      {benchWarmer && (
      <div class="award-card">
        <div class="award-icon">🪑</div>
        <div class="award-title">Bench Warmer</div>
        <div class="award-winner">{benchWarmer.owner_name}</div>
        <div class="award-value">{benchWarmer.total_bench_points.toFixed(1)} pts</div>
      </div>
      )}
    </div>
  </div>

  <div class="elimination-bracket-section">
    <h2>Elimination Timeline</h2>
    <p class="subtitle">Week by week elimination results</p>
    
    <div class="bracket-container">
      {Array.from({ length: current_week - 1 }).map((_, weekIndex) => {
        const week = weekIndex + 1;
        const eliminated = teams.filter(t => t.eliminated_week === week);
        const remaining = teams.filter(t => !t.eliminated_week || t.eliminated_week > week).length;
        
        return (
          <div class="week-elimination">
            <div class="week-header">
              <div class="week-label">Week {week}</div>
              <div class="remaining-count">{remaining} remaining</div>
            </div>
            <div class="elimination-content">
              {eliminated.length > 0 ? (
                eliminated.map(team => {
                  const weekScore = team.weekly_scores.find(w => w.week === week);
                  return (
                    <div class="eliminated-player">
                      <div class="player-name">{team.owner_name}</div>
                      <div class="elimination-score">{weekScore?.points.toFixed(1) || '0.0'} pts</div>
                      <div class="eliminated-badge">Chopped</div>
                    </div>
                  );
                })
              ) : (
                <div class="no-elimination">No eliminations</div>
              )}
            </div>
          </div>
        );
      })}
      
      {current_week > 14 && teams.filter(t => !t.eliminated_week).length > 0 && (
        <div class="week-elimination finals">
          <div class="week-header finals-header">
            <div class="week-label">Finals</div>
            <div class="remaining-count">{teams.filter(t => !t.eliminated_week).length} finalists</div>
          </div>
          <div class="elimination-content finals-content">
            {teams.filter(t => !t.eliminated_week).map(team => (
              <div class="finalist">
                <div class="player-name">{team.owner_name}</div>
                <div class="finalist-stats">
                  <div>{team.avg_points_per_game.toFixed(1)} PPG</div>
                  <div>{team.total_points_scored.toFixed(1)} total pts</div>
                </div>
                <div class="finalist-badge">Finalist</div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>

  {/* Waiver Wire Section */}
  {faabMovesByWeek.length > 0 && (
  <div class="waiver-section" style="margin-top: 40px;">
    <h2 style="text-align: center; color: #2d3748; margin-bottom: 5px;">Waiver Wire</h2>
    <p style="text-align: center; color: #888; margin-bottom: 25px;">{(archiveFaabMoves as any[]).length} moves · {'$'}{totalLeagueSpent} total spent</p>

    <div class="waiver-weeks">
      {faabMovesByWeek.map((wk) => (
        <div class="waiver-week-block">
          <div class="waiver-week-header">
            <span class="waiver-week-label">Week {wk.week}</span>
            <span class="waiver-week-total">{wk.moves.length} move{wk.moves.length !== 1 ? 's' : ''} · {'$'}{wk.weekTotal}</span>
          </div>
          <div class="waiver-moves-list">
            {wk.moves.map((m: any) => (
              <div class="waiver-move">
                <div class="waiver-move-bid">{'$'}{m.bid}</div>
                <div class="waiver-move-details">
                  <div class="waiver-move-player">
                    {m.player_name} <span class="pos-badge">{m.position}</span>
                  </div>
                  <div class="waiver-move-meta">
                    {m.owner}
                    {m.dropped && <span class="waiver-drop"> · dropped {m.dropped}</span>}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    {/* Team Budget Summary */}
    {faabByTeam.length > 0 && totalLeagueSpent > 0 && (
    <div class="table-container" style="margin-top: 25px;">
      <h3 style="color: #2c3e50; margin-bottom: 10px;">💵 Team Budgets <span style="color:#888; font-size:14px; font-weight:normal;">({'$'}{maxFAAB} per team)</span></h3>
      <div style="overflow-x: auto;">
        <table class="stats-table">
          <thead>
            <tr>
              <th style="text-align:left;">Team</th>
              <th style="text-align:center;">Spent</th>
              <th style="text-align:center;">Remaining</th>
              <th style="text-align:center;">Moves</th>
            </tr>
          </thead>
          <tbody>
            {faabByTeam.map((t) => {
              const pctUsed = maxFAAB > 0 ? (t.spent / maxFAAB) * 100 : 0;
              const remainingColor = t.remaining < maxFAAB * 0.2 ? '#f44336' : t.remaining < maxFAAB * 0.5 ? '#FF9800' : '#4CAF50';
              return (
                <tr>
                  <td style="font-weight: 600;">{t.owner_name}</td>
                  <td style="text-align:center; font-weight:bold; color:#667eea;">{'$'}{t.spent}</td>
                  <td style="text-align:center;">
                    <span style={`color:${remainingColor}; font-weight:bold;`}>{'$'}{t.remaining}</span>
                    <div style="background:#e2e8f0; border-radius:4px; height:6px; margin-top:4px; overflow:hidden;">
                      <div style={`height:100%; border-radius:4px; width:${pctUsed}%; background:${pctUsed > 80 ? '#f44336' : pctUsed > 50 ? '#FF9800' : '#667eea'};`}></div>
                    </div>
                  </td>
                  <td style="text-align:center;">{t.moves}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
    )}
  </div>
  )}

  <div class="chart-container" style="height: 600px; margin-top: 40px; margin-bottom: 40px;">
    <h3 style="text-align: center; color: #667eea; margin-bottom: 20px;">Weekly Performance (All Teams)</h3>
    <canvas id="leagueChart"></canvas>
  </div>

  {best_theoretical_lineups && best_theoretical_lineups.some(w => w.points > 0) && (
  <div class="table-container">
    <h3 style="text-align: center; color: #667eea; margin-bottom: 20px;">Best Theoretical Lineup by Week</h3>
    <p style="text-align: center; color: #666; margin-bottom: 15px;">
        The highest possible scoring lineup constructed from ALL players in the Dynasty league.
        <br/>
        <strong>Season Average: {avg_best_theoretical_lineup} pts</strong>
    </p>
    <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                    <th style="padding: 12px; text-align: left;">Week</th>
                    <th style="padding: 12px; text-align: left;">Total Points</th>
                    <th style="padding: 12px; text-align: left;">Optimal Lineup</th>
                </tr>
            </thead>
            <tbody>
                {best_theoretical_lineups.map((weekData) => (
                <tr style="border-bottom: 1px solid #eee;">
                    <td style="padding: 12px; font-weight: bold;">Week {weekData.week}</td>
                    <td style="padding: 12px; font-weight: bold; color: #2d3748;">{weekData.points}</td>
                    <td style="padding: 12px;">
                        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                            {weekData.lineup.map((player) => (
                            <span style="background: #f7fafc; padding: 4px 8px; border-radius: 4px; font-size: 0.9em; border: 1px solid #e2e8f0;">
                                <strong>{player.slot}:</strong> {player.player} ({player.points})
                            </span>
                            ))}
                        </div>
                    </td>
                </tr>
                ))}
            </tbody>
        </table>
    </div>
  </div>
  )}

  <script is:inline>
    function sortTable(columnIndex) {
      const table = document.getElementById('statsTable');
      const tbody = document.getElementById('tableBody');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      
      const currentSort = table.getAttribute('data-sort-col');
      const currentDir = table.getAttribute('data-sort-dir') || 'desc';
      const newDir = (currentSort == columnIndex && currentDir === 'desc') ? 'asc' : 'desc';
      
      table.setAttribute('data-sort-col', columnIndex);
      table.setAttribute('data-sort-dir', newDir);
      
      rows.sort((a, b) => {
        let aVal, bVal;
        if (columnIndex === 1) {
          aVal = a.cells[columnIndex].textContent.trim().toLowerCase();
          bVal = b.cells[columnIndex].textContent.trim().toLowerCase();
          return newDir === 'asc' ? aVal.localeCompare(bVal) : bVal.localeCompare(aVal);
        } else {
          aVal = parseFloat(a.cells[columnIndex].getAttribute('data-value')) || 0;
          bVal = parseFloat(b.cells[columnIndex].getAttribute('data-value')) || 0;
          return newDir === 'asc' ? aVal - bVal : bVal - aVal;
        }
      });
      
      rows.forEach(row => tbody.appendChild(row));
    }
  </script>
  
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script define:vars={{ chartTeams, weeks }}>
    const ctx = document.getElementById('leagueChart').getContext('2d');
    if (Chart.getChart(ctx)) { Chart.getChart(ctx).destroy(); }

    const colors = [
      'rgba(54, 162, 235, 1)', 'rgba(255, 99, 132, 1)', 'rgba(75, 192, 192, 1)',
      'rgba(255, 159, 64, 1)', 'rgba(153, 102, 255, 1)', 'rgba(255, 205, 86, 1)',
      'rgba(201, 203, 207, 1)', 'rgba(255, 105, 180, 1)', 'rgba(0, 128, 128, 1)',
      'rgba(165, 42, 42, 1)', 'rgba(0, 0, 128, 1)', 'rgba(128, 128, 0, 1)'
    ];

    const datasets = chartTeams.map((team, idx) => {
      const color = colors[idx % colors.length];
      return {
        label: team.owner_name,
        data: team.weekly_scores.map(w => w.points),
        borderColor: color,
        backgroundColor: color.replace('1)', '0.1)'),
        borderWidth: 2, tension: 0.4, fill: false
      };
    });

    new Chart(ctx, {
      type: 'line',
      data: { labels: weeks.map(w => `Week ${w}`), datasets: datasets },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: {
          legend: { position: 'top', labels: { usePointStyle: true, boxWidth: 10 } },
          tooltip: { mode: 'index', intersect: false }
        },
        scales: {
          x: { title: { display: true, text: 'Week' }, ticks: { autoSkip: false, maxRotation: 45, minRotation: 45 } },
          y: { beginAtZero: false, title: { display: true, text: 'Points Scored' } }
        }
      }
    });
  </script>

